{
  "type": "object",
  "additionalProperties": false,
  "required": ["headline", "summary", "experience", "projects", "skills"],
  "$defs": {
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "sources"],
      "properties": {
        "text": {"type": "string"},
        "sources": {"type": "array", "items": {"type": "string"}, "description": "IDs of the profile entries or answers this text is drawn from"}
      }
    }
  },
  "properties": {
    "headline": {"type": "string", "description": "One of the profile's headline_variants, or the posted title if the profile supports it"},
    "summary": {"$ref": "#/$defs/line"},
    "experience": {
      "type": "array",
      "description": "Every role in the profile, most recent first, using profile experience ids",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "brief", "bullets"],
        "properties": {
          "id": {"type": "string"},
          "brief": {"type": "boolean", "description": "true for an old, unrelated role shown as one line under Earlier experience, with no bullets"},
          "bullets": {"type": "array", "items": {"$ref": "#/$defs/line"}}
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string", "description": "One sentence about what it does and why it's notable. Don't repeat the project name; it's shown automatically."}
        }
      }
    },
    "skills": {
      "type": "array",
      "description": "3 or 4 groups",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "items"],
        "properties": {
          "group": {"type": "string"},
          "items": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
